# /etc/nse-price-relay.env — secrets for the price relay (chmod 600, owner root).
# setup.sh copies this template there once; edit THAT file (sudo nano /etc/nse-price-relay.env).
# Never put real values in this example file or in git.
#
# Angel One SmartAPI — the "ShagStocks" app (the one whose Secondary Static IP you set to
# this VM's reserved IP). Same values as the [angel_one] Streamlit secrets.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
# Your Angel One login PIN (angel_fetcher sends it as the password)
ANGEL_PASSWORD=
# The TOTP secret (the long code shown when you enabled TOTP), NOT a 6-digit code
ANGEL_TOTP_SECRET=

# Shared database: the SAME value as the DATABASE_URL Streamlit / GitHub secret (Neon)
DATABASE_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# Seconds between quote pulls (default 20; minimum 5). Lower = more database transfer.
#RELAY_INTERVAL_S=20
# Most symbols relayed (default 250)
#RELAY_MAX_SYMBOLS=250
# One Telegram message a day if the relay gets no quotes for ~5 minutes
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# DEBUG for more detail in journalctl
#RELAY_LOG_LEVEL=INFO
